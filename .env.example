# Server
PORT=
NODE_ENV=

# Database
MONGO_URI=
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=

# Approval Token
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_EXPIRES_HOURS=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Brevo (Email)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# App
BACKEND_URL=
GPASSWORD=

# Single intake desk — every student request is emailed here first, and this
# person forwards it onwards by typing an address into the Forward form
DSW_EMAIL=onestopsolution@mru.edu.in
DSW_LABEL=Dean of Student Welfare

# ── Push notifications (optional) ──
# Expo relays to FCM/APNs using the credentials registered against the EAS
# project (see ../secrets/README.md) — the server never reads those keys.
# This token is not required, but without it anyone who learns a push token
# can send notifications that look like they came from MR One.
EXPO_ACCESS_TOKEN=

# ── Escalation tuning (all optional, sensible defaults in code) ──
# How often to scan for overdue stages. Default 15.
ESCALATION_SWEEP_MINUTES=
# How long the escalation Reply/Forward link stays usable. Default 336 (14 days).
ESCALATION_RESPONSE_EXPIRES_HOURS=
# How many times that link may be used. Default 10.
ESCALATION_RESPONSE_MAX_USES=
